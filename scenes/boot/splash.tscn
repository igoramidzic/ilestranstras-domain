[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/boot/splash.gd" id="1_splash"]

[node name="Splash" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_splash")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Game Title"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.5)
text = "made with Godot"
horizontal_alignment = 1
